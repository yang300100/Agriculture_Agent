@{
    # ================================================================
    # Python 与依赖环境
    # ================================================================

    # 希望用来创建 .venv 虚拟环境的 Python 版本。
    # 推荐使用 3.11；若目标电脑没有 3.11，启动器会自动再尝试 3.10。
    # 不建议使用过新的 Python 版本，以免 PyTorch 暂无对应安装包。
    PythonVersion = "3.11"

    # $true：启动时先检查 torch、timm 等依赖，缺少时自动联网安装。
    # $false：完全跳过依赖检查，适合已经手动配置好 PyTorch/CUDA 的环境。
    # 已安装且可正常导入的依赖不会重复下载，因此通常保持 $true 即可。
    InstallDependencies = $true

    # ================================================================
    # 模型结构
    # 修改本节参数会改变模型结构；从 checkpoint 续训时应与原训练保持一致。
    # ================================================================

    # ConvNeXt V2 骨干网络名称。
    # convnextv2_base：默认正式训练模型，精度潜力较高，但显存和计算量较大。
    # convnextv2_tiny：速度更快、显存占用更低，适合小显存显卡或流程测试。
    Backbone = "convnextv2_base"

    # 输入图像会统一缩放/裁剪到此尺寸，单位为像素。
    # 默认 256；增大可能保留更多细小病斑，但显存和计算量会近似按面积增长。
    # 显存不足可尝试 224；修改后不宜直接加载不同尺寸配置下的旧 checkpoint。
    ImageSize = 256

    # 多尺度特征融合层的通道数。
    # 数值越大，融合模块容量和显存占用越高；默认 256，轻量测试可尝试 128。
    # 修改此值会改变网络参数形状，不能直接续训结构不一致的 checkpoint。
    FusionChannels = 256

    # 分类头的 Dropout 概率，范围应为 0.0～1.0，通常建议 0.1～0.5。
    # 较大值可缓解过拟合，但过大会导致收敛变慢或欠拟合；默认 0.3。
    Dropout = 0.3

    # 模型内部层级一致性约束的强度，用于协调作物、病害与联合类别预测。
    # 这是模型前向计算中的约束强度，不等同于下方 ConsistencyLossWeight。
    # 默认 0.3；若一致性约束压制了各任务独立学习，可适当调低。
    ConsistencyStrength = 0.3

    # $true：加载 ImageNet 预训练骨干，通常收敛更快、效果更好，首次运行需联网下载。
    # $false：完全随机初始化，适合离线测试，但通常需要更多训练轮数且效果可能下降。
    UsePretrained = $true

    # ================================================================
    # 训练规模与优化器
    # ================================================================

    # 总训练轮数。完整遍历一次训练集记为 1 个 Epoch。
    # 默认 30；可依据验证集指标调整。轮数过少可能未收敛，过多可能过拟合。
    # 续训时该值表示目标总轮数，例如已完成 20 轮、设为 40 会继续训练到第 40 轮。
    Epochs = 30

    # 前多少个 Epoch 冻结预训练骨干，只训练新增的融合层和任务头。
    # 默认 3，可降低训练初期显存/震荡；设为 0 表示从第一轮起训练全部参数。
    # 此值必须小于或等于 Epochs。
    FreezeEpochs = 3

    # 每次送入显卡的图像数量，是影响显存占用最明显的参数。
    # 默认 16；显存不足或出现 CUDA out of memory 时依次尝试 8、4、2。
    # 更改 Batch 后可能需要相应微调 LearningRate，且实验对比时应保持一致。
    BatchSize = 16

    # DataLoader 并行读取图像的工作进程数，只影响数据加载速度，不改变模型。
    # 默认 4；CPU 核心较多可尝试 8。Windows 出现卡住、进程报错时改为 0。
    Workers = 4

    # AdamW 初始学习率。默认 0.0001（1e-4）。
    # 训练损失剧烈震荡可降至 0.00005；收敛过慢可谨慎提高到 0.0002。
    # 学习率对最终效果影响较大，每次修改后建议保留独立实验目录。
    LearningRate = 0.0001

    # AdamW 权重衰减，用于抑制参数过度增大和过拟合。
    # 默认 0.05；常见尝试范围约为 0.01～0.1，不等同于 Dropout。
    WeightDecay = 0.05

    # 随机种子，用于尽量复现数据打乱、初始化和增强过程。
    # 公平比较不同模型或参数时应保持相同；改变它可测试结果的稳定性。
    Seed = 42

    # ================================================================
    # 多任务损失权重
    # 数值越大，该任务对总损失和参数更新的影响越强；不要求四项之和等于 1。
    # 公平复现实验时建议保持默认值，只在有验证依据时单独调整。
    # ================================================================

    # 作物种类分类损失的权重。
    CropLossWeight = 0.3

    # 病害种类分类损失的权重。
    DiseaseLossWeight = 0.3

    # 病害严重度分类损失的权重。
    # 数据中 severity_index=-1 的未标注样本会被自动忽略，不会当作正常类别训练。
    SeverityLossWeight = 0.2

    # 作物、病害与联合类别之间层级一致性损失的权重。
    # 若单项分类准确率正常但组合预测互相矛盾，可尝试适度提高。
    ConsistencyLossWeight = 0.1

    # ================================================================
    # 数据、输出与断点续训
    # 相对路径均以解压后的训练包根目录为基准，通常无需修改。
    # ================================================================

    # prepared 数据目录，其中必须包含 manifest.csv 和 taxonomy.json。
    # 清单中的图像路径已经改为相对路径，因此整个训练包可移动到其他盘符。
    PreparedDir = "train_data\prepared"

    # 保存完整训练状态、每轮 checkpoint、训练历史和测试指标的目录。
    # 进行不同参数实验时应换一个新目录，避免续训到不匹配的旧实验。
    ExperimentDir = "experiments\hmpd_portable"

    # 验证集表现最佳模型的输出位置；这是用于推理/部署的最佳权重文件。
    OutputModel = "model_all\weights\hmpd_best.pth"

    # $true：在 ExperimentDir 中查找 latest_checkpoint.pth 并自动继续训练。
    # 若目录中没有 checkpoint，会从头开始；全新实验也可以设为 $false。
    Resume = $true

    # 手动指定某个完整训练 checkpoint，例如：
    # "experiments\hmpd_portable\checkpoints\checkpoint_epoch_010.pth"
    # 留空时由 Resume 决定是否自动寻找最新断点；填写后优先级高于 Resume。
    # 这里应使用完整训练 checkpoint，而不是仅用于推理的普通权重文件。
    Checkpoint = ""

    # ================================================================
    # 调试与快速链路测试
    # ================================================================

    # 每个 Epoch 最多训练多少个 batch；0 表示使用完整训练集，不作限制。
    # 例如设为 2 可快速确认数据、模型和显卡链路，但结果不能代表正式性能。
    MaxTrainBatches = 0

    # 验证集和测试集最多评估多少个 batch；0 表示评估完整数据集。
    # 非 0 仅适合冒烟测试，不应据此报告准确率、Macro-F1 或模型优劣。
    MaxEvalBatches = 0
}
