# =============================================================================
# 智能种植规划助手 — 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ⚠️ 此文件可以提交到 Git，不要在此填写真实 Key！
# =============================================================================

# ── LLM 对话模型（必填）──────────────────────────────────────────────
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2

# ── 深度学习模型配置（本地推理）──────────────────────────────────────
DL_BACKEND=torch                      # HMPD-Net 使用 PyTorch 推理后端
DL_MODELS_DIR=models/weights          # 模型权重目录
DL_DEVICE=cpu                         # 推理设备: "cpu" | "cuda"
DL_DEFAULT_MODEL=hmpd_net             # 默认模型ID (HMPD-Net, 47类联合分类)

# ── 天气服务（可选）─────────────────────────────────────────────────
WEATHER_API_PROVIDER=qweather         # qweather 或 openweathermap
WEATHER_API_KEY=

# ── Agent 行为 ────────────────────────────────────────────────────
AUTONOMY_LEVEL=medium                 # low(全部确认) / medium(规则内自动) / high(完全自主)
ENABLE_IMAGE_ANALYSIS=true            # 是否启用本地DL图片分析（需要模型权重）
DEBUG_MODE=false

# ── 自主决策配置 ──────────────────────────────────────────────────
AUTO_DECISION_INTERVAL=30             # 巡检间隔（分钟）
AUTO_DECISION_NIGHT_MODE=silent       # silent=夜间静默 | full=全时段
AUTO_DECISION_TIMEOUT=120             # LLM决策超时秒数
AUTO_DECISION_MAX_ACTIONS=5           # 单次最大操作数

# ── 记忆配置 ──────────────────────────────────────────────────────
SHORT_MEMORY_TOP_K=5
SUMMARY_TRIGGER_ROUNDS=3

# ── UI 行为 ───────────────────────────────────────────────────────
WEATHER_CACHE_TTL=1800                # 天气缓存秒数（默认30分钟）
TASK_DEFAULT_DAYS=7                   # 新建任务默认截止天数

# ── 分离部署配置（可选）────────────────────────────────────────────
API_BASE=http://localhost:18001       # Streamlit 访问 FastAPI 的地址
DATABASE_URL=                         # 留空使用本地 SQLite；生产可填写 PostgreSQL URL
CORS_ORIGINS=*                        # 生产环境请改为前端域名，多个域名用逗号分隔
ENABLE_SCHEDULER=false                # 启用后由 app/start.py 单独启动调度进程
PORT=18001                            # 本地默认端口；托管平台通常会自动注入
REQUIRE_AUTH=false                    # 公网部署必须设为 true
AUTH_SECRET_KEY=                      # 公网部署填写至少 32 位的随机字符串
